<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_small"
    android:paddingBottom="@dimen/space_small">

    <!-- Row 1: type chip + sender number + timestamp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Type indicator chip (短信 / 未接来电) -->
        <TextView
            android:id="@+id/chipLogType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Sender number -->
        <TextView
            android:id="@+id/textLogSender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_small"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/textLogTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_small"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Row 2: body preview (only for SMS, max 2 lines) -->
    <TextView
        android:id="@+id/textLogBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginTop="@dimen/space_tiny"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Divider -->
    <View
        android:id="@+id/viewLogDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/space_small"
        android:background="@color/border_soft" />
</LinearLayout>
